# Copie para .env e preencha. O .env nunca vai para o Git.

# IP público ou domínio desta VPS. É o endereço que a câmera usa para mandar o vídeo.
JT1078_HOST_PUBLICO=stream.proxlive.com.br

# Porta de comandos (vai no "Server Port" da câmera) e porta de vídeo.
# As duas precisam estar abertas para a internet (TCP).
JT808_PORTA=7611
JT1078_PORTA=7612

# Controle local, usado pelo demanda.js (fica só em 127.0.0.1).
CONTROLE_PORTA=3002

# O mesmo cadastro da API do PROXLIVE.
DATA_FILE=/opt/proxlive-api/data/cameras.json

# Para onde o vídeo é publicado no MediaMTX. {slug} e {senha} são trocados na hora.
PUBLICAR_URL=rtmp://127.0.0.1:1935/{slug}?user=publisher&pass={senha}
# A mesma senha de publicação configurada no mediamtx.yml.
PUBLICAR_SENHA=

# info ou debug
LOG=info
