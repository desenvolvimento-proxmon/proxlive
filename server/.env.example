# Copie para .env e preencha. O .env nunca vai para o Git.

# Porta local da API (o Nginx publica em /api/)
PORT=3001

# Login do painel
ADMIN_USER=admin
# Gere com: node hash-senha.js "sua senha"
ADMIN_PASSWORD_HASH=

# Segredo para assinar o token de sessao.
# Gere com: openssl rand -base64 48
JWT_SECRET=

# Control API do MediaMTX (mantenha em 127.0.0.1)
MEDIAMTX_API=http://127.0.0.1:9997

# Origem autorizada a chamar a API pelo navegador
SITE_ORIGIN=https://proxlive.com.br

# Token do GitHub para disparar o rebuild do site.
# Crie um Fine-grained token com permissao "Contents: read and write"
# apenas no repositorio do PROXLIVE.
GITHUB_TOKEN=
GITHUB_REPO=desenvolvimento-proxmon/proxlive

# Onde os metadados das cameras ficam gravados
DATA_FILE=/opt/proxlive-api/data/cameras.json
